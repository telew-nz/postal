# Deployment configuration for Postal.
#
# Copy to .env in this directory and fill in. `./deploy.sh init` does this for
# you, generating the secrets and prompting only for the names it cannot invent.
#
# .env is gitignored. So is everything under deploy/database/init/, which
# deploy.sh renders from these values because it contains the database password.
#
# Every key here maps to a Postal config setting by uppercasing its dotted path:
# dns.mx_records is DNS_MX_RECORDS, postal.web_hostname is POSTAL_WEB_HOSTNAME.
# Environment always wins over deploy/config/postal.yml, including for keys that
# file does define, which is what makes one static config file work for every
# site. Array values are comma separated and each element is passed through the
# schema's transform, so POSTAL_TRUSTED_PROXIES=172.28.0.0/24 becomes a real
# IPAddr rather than a string.

# ---------------------------------------------------------------------------
# Secrets
#
# Generated by `./deploy.sh init` with `openssl rand -hex 32`. Never commit
# these, never reuse them between installations, and note that changing
# RAILS_SECRET_KEY invalidates every existing web session.

RAILS_SECRET_KEY=

# The application's database user. Leave it alone unless there is a reason to
# change it, and if there is, change it BEFORE the first `./deploy.sh init`.
#
# init renders database/init/001-postal-user.sql with this name, and the MariaDB
# image runs /docker-entrypoint-initdb.d on first initialization of an empty
# volume only. Setting it afterwards therefore leaves the application connecting
# as a user the database never granted, and re-running init re-renders a script
# which will not be executed again -- recovering means recreating the volume.
# docker-compose.yml, lib/ensure_database.rb and lib/init.sh all default it to
# this same value, so it is listed for discoverability rather than because it
# needs setting.
MAIN_DB_USERNAME=postal
MAIN_DB_PASSWORD=
# Used by deploy.sh for creating the scoped application user and for backups.
# The application itself never sees it. Keep it distinct from MAIN_DB_PASSWORD.
MARIADB_ROOT_PASSWORD=
POSTAL_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Hostnames
#
# These three have to be right and they fail in different ways.
#
# POSTAL_WEB_HOSTNAME is the public hostname the Cloudflare Tunnel serves. It is
# not a label: config/application.rb pushes exactly this one value onto
# config.hosts, and ActionDispatch::HostAuthorization answers 403 to any request
# whose Host header does not match it. Because cloudflared forwards the public
# hostname, that is what belongs here -- not the origin's name or its IP.
#
# POSTAL_SMTP_HOSTNAME is announced in the SMTP 220 banner and used for CRAM-MD5
# challenges and for Received-header loop detection. It should be the name the
# host's PTR record resolves to.
#
# DNS_HELO_HOSTNAME is the name Postal announces when it dials out to deliver
# mail. It must match the PTR record of the address the traffic actually leaves
# from, or receiving servers will penalise or reject it. It is a different
# setting from POSTAL_SMTP_HOSTNAME and it is easy to conflate the two.

POSTAL_WEB_HOSTNAME=
POSTAL_SMTP_HOSTNAME=
POSTAL_ADMIN_EMAIL=

# This host's public IPv4 address. Used by ./deploy.sh dns to print the A records
# that dns.mx_records entries need, and by ./deploy.sh doctor to check that the
# PTR record for it matches DNS_HELO_HOSTNAME. Nothing in Postal reads it: the
# address the host is reachable on is not something the application can determine
# for itself from inside a NAT'd container, which is exactly why it has to be
# stated here.
POSTAL_PUBLIC_IP=

# ---------------------------------------------------------------------------
# Management API access
#
# Used by ./deploy.sh dns and ./deploy.sh doctor to call /api/v2.
#
# POSTAL_API_TOKEN is written automatically by ./deploy.sh admin when it creates
# the first token, so that the later commands can authenticate without the
# operator pasting a key. It is a real credential with everything the
# administrator can do; .env is gitignored and chmod 600, and it is never
# forwarded into a container.
#
# POSTAL_API_BASE_URL defaults to https://POSTAL_WEB_HOSTNAME, which is the path
# a real client takes and so also tests the tunnel and HostAuthorization. Point it
# at the origin while diagnosing, e.g. http://127.0.0.1:5000 with --debug.

POSTAL_API_TOKEN=
POSTAL_API_BASE_URL=

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
#
# Create the tunnel in the Zero Trust dashboard, then add a public hostname for
# POSTAL_WEB_HOSTNAME pointing at:
#
#   http://postal:5000
#
# That is the compose service name, not localhost: cloudflared runs on the
# compose network and resolves it there. Use http, not https -- Puma serves
# plaintext and the edge terminates TLS.
#
# A tunnel carries HTTP and HTTPS only. Inbound SMTP cannot use it: every
# non-HTTP service type Cloudflare offers requires the connecting client to run
# `cloudflared access` itself. Port 25 is published on the host instead.

CLOUDFLARE_TUNNEL_TOKEN=

# Optional: provision the DNS records, tunnel, and client-domain zones
# automatically with `./deploy.sh cloudflare provision` and
# `./deploy.sh cloudflare zone add <domain>`. For all three, one token needs:
#   Zone  - DNS - Edit          (create/update the records `dns` prints)
#   Zone  - Zone - Read         (resolve the zone from the web hostname)
#   Account - CFD Tunnel - Edit (create the tunnel, read its token, set ingress)
#   Account - Zone - Edit       (`cloudflare zone add`: create client zones)
# The Zone resource scope must cover All zones (or at least every zone you
# manage), because a client zone does not exist when the token is created.
# Set CLOUDFLARE_ACCOUNT_ID when the token sees more than one account. Leave
# CLOUDFLARE_API_TOKEN empty to keep provisioning manual. The PTR record is
# never created here: it lives at the hosting provider.
#
# To use this one token for TLS issuance too, run `./deploy.sh cloudflare keys`
# (or `keys --force`), which copies it into CLOUDFLARE_DNS_API_TOKEN below.
CLOUDFLARE_API_TOKEN=

# Optional overrides. Defaults are a zone lookup from POSTAL_WEB_HOSTNAME and
# that zone's owning account.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_NAME=postal

# Pinned so that it stays inside the subnet named in config/postal.yml under
# postal.trusted_proxies and in the ipam block of docker-compose.yml. Changing
# it means changing all three.
CLOUDFLARED_IP=172.28.0.254

# ---------------------------------------------------------------------------
# DNS for sending and receiving
#
# These are published as real DNS records; `./deploy.sh dns` prints exactly what
# to create for each domain once the domains exist. Everything below defaults to
# a postal.example.com subdomain in the schema, which will silently produce mail
# that cannot be verified and cannot be delivered, so set all of them.

DNS_MX_RECORDS=
DNS_SPF_INCLUDE=
DNS_RETURN_PATH_DOMAIN=
DNS_ROUTE_DOMAIN=
DNS_TRACK_DOMAIN=
DNS_HELO_HOSTNAME=
DNS_DKIM_IDENTIFIER=postal
DNS_DOMAIN_VERIFY_PREFIX=postal-verification
DNS_CUSTOM_RETURN_PATH_PREFIX=psrp
# DMARC policy published at _dmarc.<domain> for each onboarded/published domain.
# Safe default is p=none (monitoring only). After reports confirm no spoofing,
# tighten to "v=DMARC1; p=quarantine; rua=mailto:you@example.com" then p=reject.
DNS_DMARC_POLICY=v=DMARC1; p=none
# Optional: append an rua reporting address to the DMARC policy to receive
# aggregate reports (e.g. postmaster@yourdomain.com).
# DNS_DMARC_RUA=postmaster@yourdomain.com
# Optional: publish a TLS-RPT record at _smtp.tls.<domain> to receive reports on
# TLS/MTA-STS failures (compliance + visibility). Strongly recommended.
# DNS_TLS_RPT_RUA=postmaster@yourdomain.com
# MTA-STS: run `./deploy.sh mta-sts` to write the policy file and enable it.
# This sets DNS_MTA_STS=true. The policy is served by the mtasts container at
# https://mta-sts.<web-hostname>/.well-known/mta-sts.txt through the tunnel.
# Optional overrides:
#   DNS_MTA_STS_MODE     enforce (default) | testing | none
#   DNS_MTA_STS_MAX_AGE  policy lifetime in seconds (default 604800)
# DNS_MTA_STS=false
# DNS_MTA_STS_MODE=enforce
# DNS_MTA_STS_MAX_AGE=604800
MTASTS_IMAGE=nginx:alpine

# ---------------------------------------------------------------------------
# rspamd (spam inspection)
#
# `./deploy.sh rspamd` enables rspamd and renders the per-domain allow/block
# spam rules into live rspamd maps. RSPAMD_ENABLED=true starts the rspamd
# service and makes the worker post each message to it for scoring. The host
# and port must match the compose service (rspamd) and the rspamd worker port.
RSPAMD_ENABLED=false
RSPAMD_HOST=rspamd
RSPAMD_PORT=11333
# RSPAMD_IMAGE=rspamd/rspamd:latest
# RSPAMD_PASSWORD=
# RSPAMD_FLAGS=
# Optional: publish a BIMI record (brand logo in supporting inboxes). Requires
# the SVG logo hosted at DNS_BIMI_LOGO_URL, and optionally an authority URL.
# DNS_BIMI_LOGO_URL=
# DNS_BIMI_AUTHORITY_URL=
# SPF mechanism for the include and return-path records. ~all (softfail) is the
# safe default; -all (hardfail) is a stronger anti-spoofing signal once you are
# confident every legitimate sender originates from this host.
# DNS_SPF_ALLOW=~all

# ---------------------------------------------------------------------------
# Inbound SMTP TLS
#
# Everything below except the first is read only by `./deploy.sh tls`, so an
# installation which does not want a certificate can leave the rest alone. The
# switch is what the containers actually read; `./deploy.sh tls install` sets it,
# and only after the certificate is in place and readable by uid 999.
#
# What a trusted certificate does and does not buy is at the top of lib/tls.sh.
# Inbound mail is opportunistic, so this is not a deliverability fix -- it is what
# MTA-STS enforcement and mail-client submission require.

# Whether the SMTP server offers STARTTLS. Setting this true with no readable
# certificate at config/smtp.cert is worse than leaving it false: the server
# answers "220 Ready to start TLS" and then the handshake raises, which server.rb
# logs at debug level before dropping the connection. False at least answers
# "502 TLS not available", which a sender handles by falling back to plaintext.
SMTP_SERVER_TLS_ENABLED=false

# A Cloudflare API token scoped to Zone / DNS / Edit on the zone containing
# POSTAL_SMTP_HOSTNAME and the names in DNS_MX_RECORDS, and nothing else. The
# ACME client needs it to create and remove _acme-challenge.<name> TXT records.
#
# This is deliberately not the tunnel token above: the two grant unrelated things
# and should not be the same credential. It is also not the global API key, which
# the client would accept as CF_Key plus CF_Email and which can do anything the
# account can.
CLOUDFLARE_DNS_API_TOKEN=

# Where Let's Encrypt sends expiry warnings. Must be a real address: the CA
# validates it against the public suffix list and rejects reserved domains such as
# example.com, and `./deploy.sh tls issue` refuses those before wasting a round
# trip. Worth getting right even with a renewal timer installed, because the timer
# failing silently is exactly the case this warns about.
ACME_CONTACT_EMAIL=

# Renewal window in days before expiry. Applied when the certificate is issued --
# the client records it per domain and `tls renew` reads it back from there, so
# changing it afterwards needs a `tls issue` to take effect. 30 of a 90-day
# lifetime opens the window with a month of validity still to run: about 60
# attempts at twice-daily runs, and two thirds of timer invocations do nothing.
ACME_RENEW_DAYS=30

# RSA key size. Not ECDSA: some MTAs in the wild still have TLS stacks which will
# not negotiate an ECDSA certificate, and a certificate the peer cannot use is
# worse than a larger handshake.
ACME_KEYLENGTH=2048

# Set to 2 for the ACME client's own trace when an issuance fails.
ACME_DEBUG=

# ---------------------------------------------------------------------------
# Outbound IP addresses
#
# Only used when POSTAL_USE_IP_POOLS is true, and only read by `./deploy.sh ip`.
# There is no API route for ip_addresses -- config/routes.rb exposes it under the
# web UI alone -- so registration goes through a rails runner.
#
# Comma separated, each entry ipv4=hostname. The hostname becomes the HELO
# string for mail sent from that address, because SMTPClient::Endpoint passes
# IPAddress.hostname to Net::SMTP#start, so it must equal that address's PTR
# record. The address must also be genuinely present on an interface the worker
# can see, which is why enabling pools switches the worker to host networking.
#
# POSTAL_IP_ADDRESSES=203.0.113.10=mx1.example.com,203.0.113.11=mx2.example.com
POSTAL_IP_ADDRESSES=
POSTAL_IP_POOL_NAME=Default

# Set to true to deliver from the addresses above. This switches the worker to
# host networking, so see the worker-hostnet service in docker-compose.yml
# before enabling it.
POSTAL_USE_IP_POOLS=false

# The name ./deploy.sh admin gives the first API token. Only the SHA-256 digest
# of a key is stored, so the name is the only handle on it afterwards: `DELETE
# /api/v2/tokens/{uuid}` takes the uuid, and the uuid is only discoverable by
# listing tokens and matching this name.
POSTAL_TOKEN_NAME=deploy

# ---------------------------------------------------------------------------
# Images and optional overrides
#
# Defaults are fine for most installations.

POSTAL_IMAGE=postal:local
# The tag deploy.sh builds. Leave empty to use POSTAL_IMAGE as-is; set it to
# build a versioned tag alongside, which is what makes `./deploy.sh rollback`
# have something to roll back to.
POSTAL_IMAGE_TAG=
MARIADB_IMAGE=mariadb:11
CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest

# Pinned to a version where cloudflared above is not. This container holds an
# ACME account key and the DNS-edit token, so a moving tag is a supply-chain risk
# with an unusually large blast radius and tracking upstream here buys nothing.
# Raise it deliberately, and read the client's release notes when doing so.
ACME_IMAGE=neilpang/acme.sh:3.1.1

# Health server port for the worker. Only needs changing if something else on the
# host already uses 9090, which matters when the worker is host-networked.
WORKER_HEALTH_PORT=9090

# Container log rotation. Docker's json-file driver keeps every byte written
# unless a limit is set, and a mail server left running will eventually fill the
# disk with them. The defaults keep 5 x 50MB per container, which is about 1.2GB
# across the six services here.
POSTAL_LOG_MAX_SIZE=50m
POSTAL_LOG_MAX_FILE=5

RAILS_LOG_ENABLED=true

# The management API is on by default and GET /api/v2/spec is unauthenticated, so
# anyone who can reach the hostname can enumerate the whole surface. Set this to
# false to disable the API entirely, or put a Cloudflare Access policy on the
# hostname in front of it. See the security section of doc/deployment.md.
API_ENABLED=true
